{
  "name": "tile-foundry",
  "version": "1.0.0",
  "description": "Image generation to reusable overlapping tiles, with a React playground",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node tools/verify-playground.mjs",
    "eval:skill": "python tools/run_skill_evals.py",
    "assets": "python tools/build_demo.py && python tools/build_experiments.py && python tools/build_character_experiments.py && python tools/build_skill_gallery.py",
    "test": "python -m unittest discover -s tests"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "private": true,
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
